{
  "name": "vscode-codex-commit-message-button",
  "displayName": "Codex Commit Message Button",
  "description": "A small Source Control sparkle button that uses the OpenAI Responses API or Codex CLI to write a commit message.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["SCM Providers"],
  "activationEvents": ["onCommand:codexCommitButton.generate"],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codexCommitButton.generate",
        "title": "Generate Commit Message with Codex",
        "category": "Codex",
        "icon": "$(sparkle)"
      },
      { "command": "codexCommitButton.setApiKey", "title": "Set OpenAI API Key", "category": "Codex" },
      { "command": "codexCommitButton.clearApiKey", "title": "Clear OpenAI API Key", "category": "Codex" }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "codexCommitButton.generate",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "commandPalette": [
        { "command": "codexCommitButton.generate" },
        { "command": "codexCommitButton.setApiKey" },
        { "command": "codexCommitButton.clearApiKey" }
      ]
    },
    "configuration": {
      "title": "Codex Commit Button",
      "properties": {
        "codexCommitButton.provider": {
          "type": "string",
          "enum": ["api", "cli"],
          "default": "api",
          "scope": "resource",
          "description": "How to generate commit messages: the OpenAI Responses API or the locally installed Codex CLI."
        },
        "codexCommitButton.model": {
          "type": "string",
          "enum": ["default", "gpt-5", "gpt-5-mini", "gpt-5-nano", "gpt-5.6-sol", "gpt-5.6-terra", "gpt-5.6-luna"],
          "enumDescriptions": [
            "Use gpt-5 for the API provider or the configured model for the signed-in Codex CLI.",
            "GPT-5 for API generation.",
            "A faster, lower-cost GPT-5 API model.",
            "The smallest, lowest-cost GPT-5 API model.",
            "Use gpt-5.6-sol with the Codex CLI, if available to the signed-in account.",
            "Use gpt-5.6-terra with the Codex CLI, if available to the signed-in account.",
            "Use gpt-5.6-luna with the Codex CLI, if available to the signed-in account."
          ],
          "default": "default",
          "scope": "resource",
          "description": "Model used by the selected provider. API and CLI choices are validated when generating a message.",
          "modelProviderMetadata": {
            "api": {
              "default": "gpt-5",
              "models": ["gpt-5", "gpt-5-mini", "gpt-5-nano"]
            },
            "cli": {
              "default": "default",
              "models": ["gpt-5.6-sol", "gpt-5.6-terra", "gpt-5.6-luna"]
            }
          }
        },
        "codexCommitButton.instructionsFile": {
          "type": "string",
          "default": ".instructions/commit-instructions.md",
          "scope": "resource",
          "description": "Repository-relative path to the commit-message instructions file."
        },
        "codexCommitButton.timeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 10,
          "maximum": 600,
          "description": "Maximum time to wait for Codex."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "vsce package"
  },
  "dependencies": { "openai": "^6.49.0" },
  "devDependencies": {
    "@vscode/vsce": "^3.6.2"
  }
}
